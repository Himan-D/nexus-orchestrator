# Nexus web UI (Next.js standalone output). BACKEND_URL points at the Rust core.
FROM node:22-slim AS builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM node:22-slim
RUN groupadd --system nexus && useradd --system --gid nexus --create-home nexus
WORKDIR /app
# Standalone server plus the static assets it references.
COPY --from=builder --chown=nexus:nexus /app/.next/standalone ./
COPY --from=builder --chown=nexus:nexus /app/.next/static ./.next/static
COPY --from=builder --chown=nexus:nexus /app/public ./public
USER nexus
ENV NODE_ENV=production BACKEND_URL=http://backend:3002 HOSTNAME=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
