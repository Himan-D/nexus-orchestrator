# Nexus web UI (Next.js). BACKEND_URL points at the Rust core.
FROM node:22-slim AS builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production BACKEND_URL=http://backend:3002
COPY --from=builder /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]
